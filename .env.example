# Inpol Monitor Configuration
# Copy this file to .env and fill in your actual values

# Language setting for web UI (en, pl, ru, ua)
LANGUAGE=en

# Language for Telegram/email notifications (en, pl, ru, ua)
# This is separate from LANGUAGE to allow notifications in a different language
NOTIFICATION_LANGUAGE=en

# Authentication
INPOL_USERNAME=unreal@test.com
INPOL_PASSWORD=123456
INPOL_EMAIL=unreal@gmail.com

# Telegram Bot Token (get from @BotFather)
# E.g. TELEGRAM_BOT_TOKEN=2563736777:AAGiDRrRhHy777wu9XJcwFW7SB4sMrPT75k
TELEGRAM_BOT_TOKEN=<put you telegram bot s token here>
# Allowed users to use Telegram bot are by the comma E.g. 2563736777,2563736778
AUTHORIZED_TELEGRAM_USERS=<userID>
#AUTHORIZED_TELEGRAM_USERS=2563736777,2563736778

# Database
DATABASE_PATH=data/snapshots.db

# Portal base URL
INPOL_BASE_URL=https://inpol.mazowieckie.pl

# JSON Response Logging (enable for detailed API analysis)
# Set to "true" to log all raw JSON responses to logs/json_responses.log
JSON_LOGGING_ENABLED=false


# Email Notifications (fallback when Telegram fails)
# Set to "true" to enable email notifications
# Allowing to send notifications over email additionally
EMAIL_ENABLED=true

# EMail settings
SMTP_SERVER=smtp.gmail.com
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_PORT=587
SMTP_PORT_SSL=465
SMTP_PORT_TLS=587
#E.g. SMTP_USERNAME=Karol-IV@gmail.com
SMTP_USERNAME=<your gmail address>

#E.g. SMTP_PASSWORD=KarolIV-Password
SMTP_PASSWORD=<your gmail account password>

#E.g. EMAIL_FROM=Karol-IV-POBYT@gmail.com
# Credentials are stored in credentials.json, not here
EMAIL_FROM=<the email you want to see in From line>
# This file is for configuration only
 
#E.g. EMAIL_TO=Karol-IV@gov.de
EMAIL_TO=<email address to send notification to>
 		